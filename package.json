{
  "name": "honghuang-idle-rpg",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "description": "Single-player idle open-world Honghuang text RPG",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "validate": "bun run scripts/validate-content.ts",
    "check": "bun run typecheck && bun run test && bun run validate"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
